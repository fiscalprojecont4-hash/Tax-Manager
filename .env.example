# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# NUNCA commite o .env.local (já está no .gitignore).
# A anon key é pública por design (protegida pelas políticas de RLS no banco),
# mas mesmo assim não deve ficar hardcoded direto no HTML publicado no GitHub Pages
# além do necessário — o cliente sempre pode ler chaves client-side, a segurança real
# vem das políticas RLS no Postgres, não do sigilo da anon key.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui
